{{ 'tisso-product-grid.css' | asset_url | stylesheet_tag }}

<section
  id="TissoProductGrid-{{ section.id }}"
  class="tisso-product-grid"
>
  <div class="tisso-product-grid__container">

    {% if section.settings.heading != blank %}
      <header class="tisso-product-grid__header">
        <h2 class="tisso-product-grid__heading">
          {{ section.settings.heading }}
        </h2>
      </header>
    {% endif %}

    <div class="tisso-product-grid__items">

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        {% if product != blank %}

          <article
            class="tisso-product-card"
            data-product-id="{{ product.id }}"
            {{ block.shopify_attributes }}
          >

            <div class="tisso-product-card__image-wrapper">

              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '375, 550, 750, 1000, 1200',
                    sizes: '(max-width: 749px) 50vw, 33vw',
                    class: 'tisso-product-card__image',
                    alt: product.featured_image.alt
                    | default: product.title
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'tisso-product-card__placeholder' }}
              {% endif %}


              <button
                type="button"
                class="tisso-product-card__add-button"
                style="
                  --button-top: {{ block.settings.button_top }}%;
                  --button-left: {{ block.settings.button_left }}%;
                "
                data-product-handle="{{ product.handle }}"
                aria-label="View {{ product.title }}"
              >
                <span aria-hidden="true">+</span>
              </button>

            </div>

          </article>

        {% endif %}
      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Tisso Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        },
        {
          "type": "range",
          "id": "button_top",
          "label": "Add button vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "button_left",
          "label": "Add button horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Tisso Product Grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}